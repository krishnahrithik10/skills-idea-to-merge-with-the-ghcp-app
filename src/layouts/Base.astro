---
const { title = "Mona's Bookmark Manager App" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      /* Monaspace webfonts (GitHub Next, SIL OFL 1.1) self-hosted from /public/fonts.
         Neon carries body text; Xenon gives headings a touch of contrast.
         Self-hosting keeps the app fully offline-capable — no runtime CDN needed;
         the ui-monospace fallback still covers any load failure. */
      @font-face {
        font-family: 'Monaspace Neon';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/fonts/MonaspaceNeon-400.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Neon';
        font-style: normal;
        font-weight: 600;
        font-display: swap;
        src: url('/fonts/MonaspaceNeon-600.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Neon';
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url('/fonts/MonaspaceNeon-700.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Xenon';
        font-style: normal;
        font-weight: 600;
        font-display: swap;
        src: url('/fonts/MonaspaceXenon-600.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Monaspace Xenon';
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url('/fonts/MonaspaceXenon-700.woff2') format('woff2');
      }
      :root {
        color-scheme: light;
        --accent: #315d4a;
        --border: #d3ded5;
        --muted: #596c60;
        --radius: 0.75rem;
        --font-body: 'Monaspace Neon', ui-monospace, 'SF Mono', 'Cascadia Code', monospace;
        --font-head: 'Monaspace Xenon', 'Monaspace Neon', ui-monospace, monospace;
      }
      * { box-sizing: border-box; }
      body {
        font-family: var(--font-body);
        color: #23362a;
        background: radial-gradient(ellipse at top, #e4f0e5, #f8faf5 60%);
        min-height: 100vh;
        line-height: 1.5;
        max-width: 48rem;
        margin: 0 auto;
        padding: 4rem 1.25rem;
      }
      header { margin-bottom: 2rem; }
      h1 { margin: 0 0 0.5rem; font-size: clamp(1.7rem, 5vw, 2.5rem); font-family: var(--font-head); letter-spacing: -0.04em; line-height: 1.15; }
      .tagline { margin: 0; color: var(--muted); }
      main {
        padding: clamp(1.25rem, 4vw, 2rem);
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 1.25rem;
        box-shadow: 0 1rem 3rem #25473412;
      }

      form {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        align-items: end;
        margin: 0 0 0.75rem;
      }
      .field { display: flex; flex-direction: column; gap: 0.35rem; flex: 1 1 16rem; }
      label { font-size: 0.85rem; font-weight: 600; }
      input {
        padding: 0.75rem 0.85rem;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        font: inherit;
        background: #fbfdfb;
        color: inherit;
      }
      input:focus-visible,
      button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      button {
        padding: 0.75rem 1rem;
        border: 1px solid transparent;
        border-radius: var(--radius);
        background: var(--accent);
        color: #fff;
        font: inherit;
        font-weight: 600;
        cursor: pointer;
      }
      button:hover { filter: brightness(0.94); }
      .hint { margin: 0 0 1.5rem; font-size: 0.8rem; color: var(--muted); }
      .message:empty { display: none; }
      .message { margin: 0 0 1rem; color: var(--accent); font-size: 0.85rem; }
      [hidden] { display: none !important; }

      #list-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin: 0 0 0.75rem;
      }
      .list-title { margin: 0; font-size: 1rem; font-family: var(--font-head); }
      .clear {
        background: transparent;
        color: inherit;
        border: 1px solid var(--border);
        padding: 0.35rem 0.7rem;
        font-size: 0.8rem;
        font-weight: 500;
      }
      .clear:hover { border-color: currentColor; }

      ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
      li.bookmark {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem 0.75rem;
        padding: 1rem;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: #f9fcf9;
      }
      .bookmark-text { flex: 1 1 12rem; min-width: 0; overflow-wrap: anywhere; }
      .bookmark .url { color: #235d43; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
      .bookmark .slug {
        font-family: var(--font-body);
        font-size: 0.85rem;
        color: #315d4a;
        font-weight: 700;
      }
      .bookmark .copy {
        background: transparent;
        color: inherit;
        border: 1px solid var(--border);
        padding: 0.3rem 0.6rem;
        font-size: 0.8rem;
        font-weight: 500;
      }
      .empty {
        margin: 0;
        padding: 1.5rem;
        text-align: center;
        color: var(--muted);
        border: 1px dashed #aec4b3;
        border-radius: var(--radius);
        background: #f9fcf9;
      }

      footer { margin-top: 2.5rem; font-size: 0.8rem; color: var(--muted); }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
