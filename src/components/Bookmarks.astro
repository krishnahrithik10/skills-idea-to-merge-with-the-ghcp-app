<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>
<p id="message" class="message" role="status" aria-live="polite"></p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite"></ul>

<script>
  import { createSlug, formatBookmark, normalizeUrl, parseBookmarks } from './bookmark-helpers.js';

  const form = document.querySelector<HTMLFormElement>('#add-bookmark')!;
  const input = document.querySelector<HTMLInputElement>('#url')!;
  const list = document.querySelector<HTMLUListElement>('#bookmark-list')!;
  const empty = document.querySelector<HTMLElement>('#empty-state')!;
  const header = document.querySelector<HTMLElement>('#list-header')!;
  const message = document.querySelector<HTMLElement>('#message')!;
  const storageKey = 'mona-bookmarks';
  let bookmarks: { url: string; slug: string }[] = [];

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    try {
      const url = normalizeUrl(input.value);
      const slug = createSlug(new Set(bookmarks.map((bookmark) => bookmark.slug)));
      const updated = [...bookmarks, { url, slug }];
      localStorage.setItem(storageKey, JSON.stringify(updated));
      bookmarks = updated;
      render();
      input.value = '';
      message.textContent = 'Bookmark saved.';
      input.focus();
    } catch (error) {
      message.textContent = error instanceof Error ? error.message : 'Could not save your bookmark.';
    }
  });

  function render() {
    list.replaceChildren();
    empty.hidden = bookmarks.length > 0;
    header.hidden = bookmarks.length === 0;
    for (const bookmark of bookmarks) {
      const row = document.createElement('li');
      row.className = 'bookmark';
      const text = document.createElement('span');
      text.className = 'bookmark-text';
      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = bookmark.url;
      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;
      const formatted = formatBookmark(bookmark);
      text.append(link, document.createTextNode(formatted.slice(bookmark.url.length, -bookmark.slug.length)), slug);
      const copy = document.createElement('button');
      copy.className = 'copy';
      copy.type = 'button';
      copy.textContent = 'Copy';
      copy.setAttribute('aria-label', `Copy slug for ${bookmark.url}`);
      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          message.textContent = 'Slug copied.';
        } catch {
          message.textContent = 'Could not copy the slug.';
        }
      });
      row.append(text, copy);
      list.append(row);
    }
  }

  document.querySelector<HTMLButtonElement>('#clear-all')!.addEventListener('click', () => {
    if (!confirm('Clear all saved bookmarks?')) return;
    try {
      localStorage.removeItem(storageKey);
      bookmarks = [];
      render();
      message.textContent = 'Bookmarks cleared.';
    } catch {
      message.textContent = 'Could not clear your bookmarks.';
    }
  });

  try {
    bookmarks = parseBookmarks(localStorage.getItem(storageKey));
  } catch {
    message.textContent = 'Could not load your bookmarks from browser storage.';
  }
  render();
</script>
