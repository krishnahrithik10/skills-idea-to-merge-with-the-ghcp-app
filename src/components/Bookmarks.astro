<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>
<p id="message" class="message" role="status" aria-live="polite"></p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite"></ul>

<script>
  // Browser-only. Astro does not run this script during the static build.
  import {
    BOOKMARK_SEPARATOR,
    STORAGE_KEY,
    createSlug,
    formatBookmark,
    normalizeUrl,
    parseBookmarks,
  } from './bookmark-helpers.js';

  type Bookmark = { url: string; slug: string };

  const form = requireElement<HTMLFormElement>('#add-bookmark');
  const input = requireElement<HTMLInputElement>('#url');
  const list = requireElement<HTMLUListElement>('#bookmark-list');
  const emptyState = requireElement<HTMLElement>('#empty-state');
  const listHeader = requireElement<HTMLElement>('#list-header');
  const status = requireElement<HTMLElement>('#message');
  const clearAll = requireElement<HTMLButtonElement>('#clear-all');

  let bookmarks = loadBookmarks();
  renderBookmarks();

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    try {
      saveBookmark(input.value);
      input.value = '';
      showStatus('Bookmark saved.');
      input.focus();
    } catch (error) {
      showStatus(errorText(error, 'Could not save your bookmark.'));
    }
  });

  clearAll.addEventListener('click', () => {
    if (!confirm('Clear all saved bookmarks?')) return;
    try {
      localStorage.removeItem(STORAGE_KEY);
      bookmarks = [];
      renderBookmarks();
      showStatus('Bookmarks cleared.');
    } catch {
      showStatus('Could not clear your bookmarks.');
    }
  });

  function loadBookmarks(): Bookmark[] {
    try {
      return parseBookmarks(localStorage.getItem(STORAGE_KEY));
    } catch {
      showStatus('Could not load your bookmarks from browser storage.');
      return [];
    }
  }

  function saveBookmark(rawUrl: string) {
    const bookmark = {
      url: normalizeUrl(rawUrl),
      slug: createSlug(new Set(bookmarks.map((item) => item.slug))),
    };
    const next = [...bookmarks, bookmark];
    localStorage.setItem(STORAGE_KEY, JSON.stringify(next));
    bookmarks = next;
    renderBookmarks();
  }

  function renderBookmarks() {
    const hasBookmarks = bookmarks.length > 0;
    emptyState.hidden = hasBookmarks;
    listHeader.hidden = !hasBookmarks;
    list.replaceChildren(...bookmarks.map(createBookmarkRow));
  }

  function createBookmarkRow(bookmark: Bookmark) {
    const row = document.createElement('li');
    row.className = 'bookmark';

    const text = document.createElement('span');
    text.className = 'bookmark-text';
    text.append(createUrlLink(bookmark.url), separator(), createSlugBadge(bookmark.slug));

    row.append(text, createCopyButton(bookmark));
    return row;
  }

  function createUrlLink(url: string) {
    const link = document.createElement('a');
    link.className = 'url';
    link.href = url;
    link.target = '_blank';
    link.rel = 'noopener noreferrer';
    link.textContent = url;
    return link;
  }

  function separator() {
    return document.createTextNode(BOOKMARK_SEPARATOR);
  }

  function createSlugBadge(slug: string) {
    const badge = document.createElement('span');
    badge.className = 'slug';
    badge.textContent = slug;
    return badge;
  }

  function createCopyButton(bookmark: Bookmark) {
    const button = document.createElement('button');
    button.className = 'copy';
    button.type = 'button';
    button.textContent = 'Copy';
    button.setAttribute('aria-label', `Copy ${formatBookmark(bookmark)}`);
    button.addEventListener('click', () => copySlug(bookmark.slug));
    return button;
  }

  async function copySlug(slug: string) {
    try {
      await navigator.clipboard.writeText(slug);
      showStatus('Slug copied.');
    } catch {
      showStatus('Could not copy the slug.');
    }
  }

  function showStatus(text: string) {
    status.textContent = text;
  }

  function errorText(error: unknown, fallback: string) {
    return error instanceof Error ? error.message : fallback;
  }

  function requireElement<T extends Element>(selector: string): T {
    const element = document.querySelector<T>(selector);
    if (!element) throw new Error(`Missing required element: ${selector}`);
    return element;
  }
</script>
